---
import Reveal from "./Reveal.astro";
const impacts = [
    {
        stat: "4,000L",
        label: "Coconut water upcycled montlhy",
    },
    {
        stat: "100%",
        label: "Cruelty-free & Bio-based",
    },
    {
        stat: "85%",
        label: "Lower CO2 emissions",
    },
];
---

<section id="impact" class="relative py-32 overflow-hidden">
    <!-- ATMOSPHERIC BACKGROUND -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-0 -left-40 w-[500px] h-[500px] rounded-full bg-white/5 blur-[140px]"
        >
        </div>

        <div
            class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-stone-400/5 blur-[120px]"
        >
        </div>
    </div>

    <!-- CONTENT -->
    <div class="relative max-w-7xl mx-auto px-6">
        <div class="max-w-3xl">
            <div class="text-sm uppercase tracking-[0.3em] text-stone-400 mb-4">
                Environmental Impact
            </div>

            <Reveal>
                <h2 class="text-4xl md:text-6xl font-semibold">
                    Sustainability should be measurable.
                </h2>
            </Reveal>

            <p class="mt-8 text-lg text-stone-300 leading-relaxed">
                Every COLLABS creation divert organic waste from landfills, transforming acidic coconut water
                into high-value biomaterials through a zero-chemical tanning process.
            </p>
        </div>

        <div class="mt-20 grid md:grid-cols-3 gap-8">
            {
                impacts.map((item) => (
                    <div class="rounded-[2rem] border border-white/10 bg-white/[0.03] backdrop-blur-sm p-10">
                        <div class="text-6xl font-semibold">{item.stat}</div>

                        <p class="mt-5 text-stone-400 text-lg leading-relaxed">
                            {item.label}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
