---
const impacts = [
    {
        stat: "68%",
        label: "Reduced production waste",
    },
    {
        stat: "100%",
        label: "Thoughtfully sourced materials",
    },
    {
        stat: "5x",
        label: "Longer usable lifecycle",
    },
];
---

<section id="impact" class="py-32">
    <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-3xl">
            <div class="text-sm uppercase tracking-[0.3em] text-stone-400 mb-4">
                Environmental Impact
            </div>

            <h2 class="text-4xl md:text-6xl font-semibold leading-tight">
                Sustainability should be measurable.
            </h2>

            <p class="mt-8 text-lg text-stone-300 leading-relaxed">
                Every production decision should reduce waste, extend product
                life, and encourage mindful consumption.
            </p>
        </div>

        <div class="mt-20 grid md:grid-cols-3 gap-8">
            {
                impacts.map((item) => (
                    <div class="rounded-[2rem] border border-white/10 bg-white/[0.03] p-10">
                        <div class="text-6xl font-semibold">{item.stat}</div>

                        <p class="mt-5 text-stone-400 text-lg leading-relaxed">
                            {item.label}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
