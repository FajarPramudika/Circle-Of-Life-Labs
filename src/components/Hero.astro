---
import { getImageUrl } from "../lib/imageUrl"
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
    <div class="blur-orb w-[400px] h-[400px] bg-white top-0 right-0"></div>

    <!-- Replaced video with lightweight background image -->
    <div class="absolute inset-0">
        <img
            src="https://plus.unsplash.com/premium_photo-1673978423093-e54ddb60304a?q=80&w=1920&auto=format&fit=crop"
            alt="Background visual"
            class="w-full h-full object-cover"
            loading="lazy"
        />
    </div>

    <div
        class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-stone-950"
    >
    </div>

    <div
        class="relative max-w-7xl mx-auto px-4 md:px-6 pt-28 md:pt-32 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center"
    >
        <div>
            <div
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/15 text-xs uppercase tracking-[0.3em] text-stone-300 mb-6"
            >
                Sustainable Leather Innovation
            </div>

            <h1
                class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold leading-[0.95] tracking-tight"
            >
                Transforming agricultural waste into conscious luxury.
            </h1>

            <p
                class="mt-6 md:mt-8 text-base md:text-lg text-stone-300 max-w-xl leading-relaxed"
            >
                Premium bioleather crafted from recycled mature coconut water.
                Sustainable, natural, and timlessly beautiful.
            </p>

            <div class="mt-8 md:mt-10 flex flex-col sm:flex-row gap-4">
                <button
                    class="px-7 py-4 rounded-full bg-white text-black font-medium hover:-translate-y-1 transition duration-300"
                >
                    Explore Products
                </button>

                <button
                    class="px-7 py-4 rounded-full border border-white/15 hover:bg-white hover:text-black transition duration-300"
                >
                    Learn More
                </button>
            </div>
        </div>

        <div class="relative hidden lg:block h-[500px] xl:h-[600px]">
            <div
                class="absolute top-0 right-0 w-[330px] md:w-[430px] h-[420px] md:h-[520px] rounded-[3rem] overflow-hidden hover:rotate-3 transition duration-700 shadow-2xl"
            >
                <img
                    src={getImageUrl('cover.webp')}
                    class="w-full h-full object-cover"
                    alt="Luxury leather product"
                    loading="lazy"
                />
            </div>

            <!-- <div
                class="absolute left-0 bottom-0 w-[320px] rounded-[2rem] border border-white/10 bg-stone-900/80 backdrop-blur-xl p-8 shadow-2xl"
            >
            </div> -->
        </div>
    </div>
</section>
