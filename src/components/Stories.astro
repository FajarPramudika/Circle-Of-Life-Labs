---
import { getImageUrl } from "../lib/imageUrl"

const stories = [
    "How modern leather goods are evolving",
    "Why sustainable materials matter in fashion",
    "Designing products for long-term ownership",
];
const images = [
    "kelapa_tua.webp",
    "selulosa_mikrobial.webp",
    "craft_leather.webp",
]
---

<section
    id="stories"
    class="py-24 md:py-32 border-y border-white/10 bg-stone-900/40"
>
    <div class="max-w-7xl mx-auto px-6">
        <div
            class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8"
        >
            <div>
                <div
                    class="text-sm uppercase tracking-[0.3em] text-stone-400 mb-4"
                >
                    Stories
                </div>

                <h2
                    class="text-4xl md:text-6xl font-semibold leading-tight max-w-3xl"
                >
                    Where biology meets the art of craft.
                </h2>
            </div>

            <p class="max-w-xl text-stone-300 text-lg leading-relaxed">
                Editorial content, product journeys, and material storytelling.
            </p>
        </div>

        <div
            class="mt-16 md:mt-20 grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8"
        >
            {
                stories.map((story, index) => (
                    <article class="group overflow-hidden rounded-[2rem] border border-white/10">
                        <div class="overflow-hidden">
                            <img
                                src={getImageUrl(`storyimg${index}.webp`)}
                                class="w-full h-72 sm:h-80 md:h-96 object-cover group-hover:scale-105 transition duration-700"
                                loading="lazy"
                            />
                        </div>

                        <div class="p-6 md:p-8">
                            <div class="text-sm text-stone-500 uppercase tracking-[0.2em] mb-4">
                                Editorial
                            </div>

                            <h3 class="text-xl sm:text-2xl font-medium leading-snug">
                                {story}
                            </h3>

                            <button class="mt-8 text-stone-300 hover:text-white transition">
                                Read Story →
                            </button>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
